# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit credentials or paths.

# Docker image tag
IMAGE_TAG=ida-vnc:9.4

# Container runtime settings
HOST_PORT=8443
VNC_PASSWORD=changeme

# Local paths for runtime mounts (absolute paths on the host)
# Persistent workspace: mounted as /home/kasm-user/workspace.
# Keep your binaries/samples here — IDA saves .i64/.idb next to the binary.
WORKSPACE_HOST_PATH=/path/to/IDA-workspace

# Persistent IDA config dir: mounted as /home/kasm-user/.idapro.
# Holds IDA settings, registry, plugins and your license.
# Put your ida.hexlic INSIDE this directory on the host.
IDA_CONFIG_HOST_PATH=/path/to/IDA-config

# Absolute path to your IDA Pro installer (.run file)
# Default: downloads/ida-pro_94_x64linux.run (relative to project root)
IDA_INSTALLER=downloads/ida-pro_94_x64linux.run
